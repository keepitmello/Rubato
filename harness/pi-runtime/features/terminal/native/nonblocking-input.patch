+    pub fn write(&mut self, data: Either3<String, Buffer, Uint8Array>) -> NativePtyWriteResult {
         let bytes = match data {
             Either3::A(text) => text.into_bytes(),
             Either3::B(buffer) => buffer.to_vec(),
             Either3::C(array) => array.to_vec(),
         };
