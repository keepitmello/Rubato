{
  "schemaVersion": 1,
  "cases": [
    {
      "name": "anthropic sliding hit",
      "model": {
        "provider": "anthropic",
        "api": "anthropic-messages",
        "id": "claude-opus-5"
      },
      "now": 61000,
      "entries": [
        {
          "type": "message",
          "message": {
            "role": "assistant",
            "timestamp": 2000,
            "timing": { "sentAt": 1000 },
            "usage": { "input": 20, "cacheRead": 80, "cacheWrite": 0 }
          }
        }
      ],
      "expected": {
        "policy": { "kind": "sliding", "ttlSeconds": 3600 },
        "hitPercent": 80,
        "status": { "text": "Cache 59m", "ticking": true, "expired": false },
        "expiresAt": "1970-01-01T01:00:01.000Z",
        "expired": false
      }
    },
    {
      "name": "OpenAI minimum retention write",
      "model": {
        "provider": "openai",
        "api": "openai-responses",
