      "now": 70000,
      "entries": [
        {
          "type": "message",
          "message": {
            "role": "assistant",
            "timestamp": 20000,
            "timing": { "sentAt": 10000 },
            "usage": { "input": 10, "cacheRead": 0, "cacheWrite": 90 }
          }
        }
      ],
      "expected": {
        "policy": { "kind": "minimum", "ttlSeconds": 1800 },
        "hitPercent": 0,
        "status": { "text": "Cache ≥ 29m", "ticking": true, "expired": false },
        "expiresAt": "1970-01-01T00:30:10.000Z",
        "expired": false
      }
    },
