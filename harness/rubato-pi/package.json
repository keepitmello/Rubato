{
  "name": "rubato-pi",
  "private": true,
  "type": "module",
  "bin": {
    "rubato-pi": "./bin/rubato-pi.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node scripts/run-unit-tests.mjs",
    "test:integration": "node --test test/integration/*.test.mjs",
    "smoke:local": "node test/smoke/local.mjs",
    "smoke:real": "node test/smoke/real.mjs",
    "smoke:direct": "node test/smoke/direct-real.mjs",
    "smoke:surfaces": "node test/smoke/stock-surfaces.mjs",
    "test:context-notes": "node --test test/unit/context-notes-*.test.mjs",
    "check:context-notes-engine": "node scripts/check-history-notes-engine.mjs",
    "test:context-cost": "node --test test/unit/context-cost-*.test.mjs"
  },
  "dependencies": {
    "undici": "8.10.0"
  }
}
