{
  "name": "@rubato/remote-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "esbuild src/main.ts src/index.ts --bundle --platform=node --format=esm --target=node24 --outdir=dist",
    "start": "node dist/main.js",
    "test": "bun test test/*.test.ts",
    "typecheck": "tsgo --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@rubato/remote-protocol": "file:../rubato-remote-protocol"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "bun-types": "1.4.0",
    "esbuild": "0.25.9"
  }
}
