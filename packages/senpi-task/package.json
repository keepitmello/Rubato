{
  "name": "@rubato/senpi-task",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Rubato task state machine and persistent record store for Senpi.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./agents-builtin": {
      "types": "./src/agents/builtin/index.ts",
      "import": "./src/agents/builtin/index.ts"
    },
    "./category-builtins": {
      "types": "./src/category/builtins.ts",
      "import": "./src/category/builtins.ts"
    },
    "./category-resolver": {
      "types": "./src/category/resolver.ts",
      "import": "./src/category/resolver.ts"
    },
    "./renderer-text": {
      "types": "./src/renderer-text.ts",
      "import": "./src/renderer-text.ts"
    },
    "./rpc-spawn": {
      "types": "./src/runners/rpc/spawn.ts",
      "import": "./src/runners/rpc/spawn.ts"
    },
    "./rpc-model-admission": {
      "types": "./src/runners/rpc/model-admission.ts",
      "import": "./src/runners/rpc/model-admission.ts"
    },
    "./task-renderers": {
      "types": "./src/tools/task/renderers.ts",
      "import": "./src/tools/task/renderers.ts"
    },
    "./notice-box": {
      "types": "./src/notice-box.ts",
      "import": "./src/notice-box.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test": "bun test src/*.test.ts src/**/*.test.ts"
  },
  "dependencies": {
    "@rubato/agent-core": "workspace:*",
    "@rubato/delegate-core": "workspace:*",
    "@rubato/config-core": "workspace:*",
    "@rubato/team-core": "workspace:*",
    "@rubato/utils": "workspace:*",
    "typebox": "1.3.16",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@code-yeongyu/senpi": "2026.9.4-3",
    "@earendil-works/pi-tui": "npm:@code-yeongyu/senpi-tui@2026.9.4-3",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@code-yeongyu/senpi": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@code-yeongyu/senpi": "2026.9.4-3",
    "@earendil-works/pi-tui": "npm:@code-yeongyu/senpi-tui@2026.9.4-3",
    "typebox": "1.3.16"
  },
  "sideEffects": false
}
