{
  "name": "@rubato/runtime",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Rubato runtime adapter for Senpi.",
  "imports": {
    "#rubato-task-runtime": "./src/extension/rubato-task.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./extension": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test": "bun test src/**/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "0.84.2",
    "@rubato/ast-grep-mcp": "workspace:*",
    "@rubato/delegate-core": "workspace:*",
    "@rubato/lsp-core": "workspace:*",
    "@rubato/mcp-stdio-core": "workspace:*",
    "@rubato/memory-core": "workspace:*",
    "@rubato/model-core": "workspace:*",
    "@rubato/config-core": "workspace:*",
    "@rubato/senpi-task": "workspace:*",
    "@rubato/team-core": "workspace:*",
    "@rubato/utils": "workspace:*",
    "@rubato/lsp-daemon": "file:../lsp-daemon",
    "typebox": "1.3.16"
  },
  "peerDependencies": {
    "@code-yeongyu/senpi": "2026.8.22"
  },
  "peerDependenciesMeta": {
    "@code-yeongyu/senpi": {
      "optional": true
    }
  },
  "devDependencies": {
    "@code-yeongyu/senpi": "2026.8.22",
    "terser": "5.50.0"
  }
}
