+ * Persistent execution journal for Cursor server-driven tool calls.
+ *
+ * See cursor-exec-journal.js for the contract. In short: a file keyed by
+ * `{conversationLineageId, toolCallId}` carrying
+ * `prepared → executing → completed | failed | unknown`, owned solely by
+ * `cursor-exec-bridge`, written under a multi-process lock with
+ * temp write → fsync → rename. Exactly-once across a restart is NOT promised;
+ * `unknown` is how that is admitted instead of guessed at.
+ */
+export declare const CURSOR_EXEC_PREPARED = "prepared";
+export declare const CURSOR_EXEC_EXECUTING = "executing";
+export declare const CURSOR_EXEC_COMPLETED = "completed";
+export declare const CURSOR_EXEC_FAILED = "failed";
+export declare const CURSOR_EXEC_UNKNOWN = "unknown";
+export declare const CURSOR_EXEC_JOURNAL_VERSION = 1;
+export declare const CURSOR_EXEC_JOURNAL_FILE = "cursor-exec-journal.json";
+export declare const CURSOR_EXEC_JOURNAL_MAX_ENTRIES = 512;
+export declare const CURSOR_EXEC_JOURNAL_TTL_MS: number;
+export declare const CURSOR_SIDE_EFFECT_NONE = "none";
+export declare const CURSOR_SIDE_EFFECT_UNKNOWN = "unknown";
+export declare const CURSOR_SIDE_EFFECT_HAPPENED = "happened";
+export type CursorExecState = "prepared" | "executing" | "completed" | "failed" | "unknown";
+/** What the journal knows about the side effect of a settled entry. */
+export type CursorExecSideEffect = "none" | "unknown" | "happened";
+export interface CursorExecJournalEntry {
+    lineageId: string;
+    toolCallId: string;
+    toolName?: string;
+    state: CursorExecState;
+    /** Process that owns the entry. Liveness of this pid decides staleness. */
+    pid?: number;
+    attempt?: number;
+    /** Present only when the tool declared one. Retries require the same value. */
+    idempotencyKey?: string;
+    /** True once state and result were written together. Gates replay. */
+    resultPersisted?: boolean;
+    result?: unknown;
+    isError?: boolean;
+    summary?: string;
