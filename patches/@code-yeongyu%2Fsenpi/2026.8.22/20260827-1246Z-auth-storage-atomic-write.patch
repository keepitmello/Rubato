+        chmodSync(tempPath, 0o600);
+        renameSync(tempPath, authPath);
+    }
+    catch (error) {
+        // Never leave the temp file behind, and never mask the original failure.
+        if (fd !== undefined) {
+            try {
+                closeSync(fd);
+            }
+            catch {
+                // Closing failed on an already-failing path; the unlink below still runs.
+            }
+        }
+        try {
+            if (existsSync(tempPath))
