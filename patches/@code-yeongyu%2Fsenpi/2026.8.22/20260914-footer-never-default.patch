+/**
+ * Rubato statusline when the host painter is missing or empty.
+ * The senpi `~/cwd • $0.000 (sub) • 2/500K (0.0%) (auto)` line must stay unreachable.
+ */
+export function paintRubatoFallback(component, width) {
+    const session = component?.session;
+    let model = "—";
+    try {
+        model = session?.model?.id || session?.state?.model?.id || "—";
+    }
+    catch {
+    }
+    let remaining = "—";
+    try {
+        const usage = session?.getContextUsage?.();
+        if (typeof usage?.percent === "number")
+            remaining = `${Math.max(0, Math.min(100, Math.round(100 - usage.percent)))}%`;
+    }
+    catch {
+    }
+    let branch = "";
+    try {
+        branch = component?.footerData?.getGitBranch?.() || "";
+    }
+    catch {
+    }
+    let repo = "";
+    try {
+        const cwd = session?.sessionManager?.getCwd?.() || "";
+        repo = cwd.replace(/[\\/]+$/, "").split(/[\\/]/).filter(Boolean).pop() || "";
+    }
+    catch {
+    }
+    const parts = [`✦ ${model}`, remaining];
+    if (branch)
+        parts.push(branch);
+    if (repo)
+        parts.push(repo);
+    parts.push("Speed —");
+    const line = parts.join(" · ");
+    if (typeof width === "number" && width > 0 && line.length > width)
+        return [line.slice(0, Math.max(1, width - 1)) + "…"];
+    return [line];
+}
