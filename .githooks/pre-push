#!/bin/sh
# 깨진 커밋을 origin 에 올리기 전에 Stage 9 로컬 게이트를 돌린다.
set -eu
repo=$(git rev-parse --show-toplevel)
if [ "${RUBATO_SKIP_CI_GATE:-}" = 1 ]; then
  printf '%s\n' "RUBATO_SKIP_CI_GATE=1: skipping local CI gate"
  exit 0
fi
printf '%s\n' "pre-push: scripts/ci-local.sh (RUBATO_SKIP_CI_GATE=1 skips)"
exec "$repo/scripts/ci-local.sh"
